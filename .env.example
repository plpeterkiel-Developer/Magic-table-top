# Copy this file to `.env.local` and fill in the values from your Supabase project.
# Find these under Project Settings -> API in the Supabase dashboard.
#
# VITE_ prefix is required for Vite to expose the variable to the browser.
# It is SAFE to commit the publishable (anon) key to the client bundle —
# row-level security in the database is what actually protects data.

VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-PUBLISHABLE-ANON-KEY
